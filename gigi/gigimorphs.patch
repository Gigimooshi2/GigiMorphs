diff --git a/extensions/youtube/src/main/java/app/morphe/extension/youtube/patches/GigiShortsFullVideoLinkPatch.java b/extensions/youtube/src/main/java/app/morphe/extension/youtube/patches/GigiShortsFullVideoLinkPatch.java
